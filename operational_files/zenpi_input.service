[Unit]
Description=GPIO Switch Monitor Service
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/ad/ZenPi/operational_files/input-controller.py
WorkingDirectory=/home/ad/ZenPi/operational_files/
StandardOutput=inherit
StandardError=inherit
Restart=always
User=ad

[Install]
WantedBy=multi-user.target